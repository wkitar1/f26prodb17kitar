extends layout

block content
  h1= title
  
  p Rows: #{query.rows}
  p Columns: #{query.cols}
  - let rows = Number(query.rows)
  - let cols = Number(query.cols)

  if !Number.isInteger(rows) || !Number.isInteger(cols)
    p Rows and columns must be integers.

  else if rows < 2 || rows > 12
    p Rows must be between 2 and 12.
  
  else if cols < 2 || cols > 12
    p Columns must be between 2 and 12.

  else 
    table#outer
      - for(let i=0; i<rows; i++) {
        tr#middle
          - for(let j=0; j<cols; j++) {
            td= j - i
          - }
      - }
  

