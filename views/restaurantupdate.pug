extends layout

block content
  h1= title
  - let restaurantid = toShow._id
  - let name = toShow.name
  - let cuisine = toShow.cuisine
  - let capacity = toShow.capacity
  - let city = toShow.city

  div.row.mb-2
    div(class='restaurantAttr mr-3') ID is:
    div #{restaurantid}

  form(id='RestaurantForm', action="/resource/restaurants/" + restaurantid, method="PUT")
    div.form-group
      label.restaurantAttr(for='name') Restaurant name
      input#name(type='text', name='name', value=name)
    div.form-group
      label.restaurantAttr(for='cuisine') Cuisine
      input#cuisine(type='text', name='cuisine', value=cuisine)
    div.form-group
      label.restaurantAttr(for='capacity') Capacity
      input#capacity(type='number', name='capacity', value=capacity)
    div.form-group
      label.restaurantAttr(for='city') City
      input#city(type='text', name='city', value=city)
    input(type="submit")

  script.
    document.forms['RestaurantForm'].addEventListener('submit', (event) => {
      event.preventDefault();
      fetch(event.target.action, {
        method: 'PUT',
        body: new URLSearchParams(new FormData(event.target))
      }).then((resp) => {
        return resp.json();
      }).then((body) => {
        alert("Update succeeded")
      }).catch((error) => {
        alert("Update failed " + error)
      });
    });