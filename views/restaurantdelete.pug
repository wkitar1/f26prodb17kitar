extends layout

block content
  h1= title
  if (toShow == null)
    h2 No instance to delete
  else
    - let restaurantid = toShow._id
    - let name = toShow.name
    - let cuisine = toShow.cuisine
    - let capacity = toShow.capacity
    - let city = toShow.city
    - let actionid = "/resource/restaurants/" + restaurantid
    script.
      let actionid = "#{actionid}"
    div
      div.row
        div(class='restaurantAttr mr-3') Restaurant ID is:
        div #{restaurantid}
      div.row
        div(class='restaurantAttr mr-3') Name is:
        div #{name}
      div.row
        div(class='restaurantAttr mr-3') Cuisine is:
        div #{cuisine}
      div.row
        div(class='restaurantAttr mr-3') Capacity is:
        div #{capacity}
      div.row
        div(class='restaurantAttr mr-3') City is:
        div #{city}
    button(class="btn btn-danger m-2" onclick="deleteOnid()") Delete
    button(class="btn btn-secondary m-2" onclick="cancel()") Cancel
    script.
      function cancel() {
        // Go back to the home page for the restaurant collection
        window.location.href = '/restaurant'
      }
      function deleteOnid() {
        console.log("starting delete")
        fetch(actionid, {
          method: 'DELETE' // Don't need a body for the delete
        }).then((resp) => {
          return resp.json();
        }).then((body) => {
          alert("Delete succeeded")
          window.location.href = '/restaurant'
        }).catch((error) => {
          alert("Delete failed " + error)
        });
      }