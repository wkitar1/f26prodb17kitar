extends layout

block content
  h1= title
  div.container-fluid
    div.row
      each restaurant, index in results
        div.col-sm-2(onclick=`buy(${index + 1})`)
          h3 #{restaurant.name}
          p Cuisine: #{restaurant.cuisine}
          p Capacity: #{restaurant.capacity}
          p City: #{restaurant.city}
  script.
    function buy(index) {
      alert("You purchased item " + index + ".");
    }

  

