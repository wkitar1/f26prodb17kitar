extends layout

block content
  h1= title
  -
    let results =[
      {
        name: "Bella Italia",
        cuisine: "Italian",
        capacity: 85,
        city: "Chicago"
      },
      {
        name: "Raku",
        cuisine: "Japanese",
        capacity: 40,
        city: "Maryville"
      },
      {
        name: "Le Petit Cafe",
        cuisine: "French",
        capacity: 60,
        city: "Kansas City"
      }
    ]
  div.container-fluid
    div.row
      each restaurant, index in results
        div.col-sm-2(onclick=`buy(${index + 1})`)
          h3 #{restaurant.name}
          p Cuisine: #{restaurant.cuisine}
          p Capacity: #{restaurant.capacity}
          p City: #{restaurant.city}
  script.
    function buy(index) {
      alert("You purchased item " + index + ".");
    }

  

